DATABASE_URL=postgresql://ctp:ctp@localhost:5432/ctp_alpha
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated frontend origins. Use * only if you intentionally allow all origins.
CORS_ORIGIN=http://localhost:3000

# NVIDIA AI / NIM-compatible API
# Configure AI only through server-side ENV. Never commit real secrets.
NVIDIA_API_KEY=
NVIDIA_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_EFFORT=medium
NVIDIA_TEMPERATURE=0.15
NVIDIA_MAX_TOKENS=4096
NVIDIA_TIMEOUT_MS=120000

# Deep Search / web research via SearX.space public SearXNG instances
# CTP discovers HTTPS instances from SearX.space and automatically rotates/fails over.
# The discovery URL is public metadata; do not expose search requests directly from the browser.
SEARXNG_DISCOVERY_URL=https://searx.space/data/instances.json
SEARXNG_INSTANCE_COUNT=8
SEARXNG_TIMEOUT_MS=12000
SEARXNG_DISCOVERY_TTL_MS=600000
SEARXNG_FAILURE_COOLDOWN_MS=60000
SEARXNG_MAX_FAILURES=1
SEARXNG_LANGUAGE=en
SEARXNG_CATEGORIES=general,news
SEARXNG_SAFESEARCH=0
# Optional: day | month | year. Leave empty for no time filter.
SEARXNG_TIME_RANGE=
# Pages per query (1-3) and final deduplicated source count (1-30).
SEARXNG_PAGES=2
SEARXNG_MAX_RESULTS=18

# Realtime crypto intelligence
NEWS_REFRESH_MS=30000
NEWS_LIMIT=100
CTP_API_URL=http://localhost:4000

NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth.js / Google OAuth
AUTH_SECRET=generate-a-long-random-secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js / Apple Sign In
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=


# Realtime ingestion
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://www.theblock.co/rss.xml,https://bitcoinmagazine.com/feed,https://cryptoslate.com/feed/,https://www.newsbtc.com/feed/,https://news.bitcoin.com/feed/,https://u.today/rss,https://cryptopotato.com/feed/,https://beincrypto.com/feed/,https://ambcrypto.com/feed/,https://cryptonews.com/news/feed/,https://blockworks.co/feed,https://dailyhodl.com/feed/,https://news.google.com/rss/search?q=(bitcoin%20OR%20ethereum%20OR%20solana%20OR%20crypto%20OR%20defi)&hl=en-US&gl=US&ceid=US:en
FRED_API_KEY=
BLS_API_KEY=

# Alert engine: keep this secret; only trusted workers/services may emit user alerts
ALERT_ENGINE_SECRET=generate-a-long-random-alert-engine-secret

# Multi-chain on-chain RPC sources. Format: chain=url,chain=url
ONCHAIN_RPC_URLS=ethereum=https://YOUR_ETH_RPC,base=https://YOUR_BASE_RPC,arbitrum=https://YOUR_ARBITRUM_RPC,bsc=https://YOUR_BSC_RPC,polygon=https://YOUR_POLYGON_RPC,solana=https://YOUR_SOLANA_RPC
ONCHAIN_RPC_TIMEOUT_MS=15000

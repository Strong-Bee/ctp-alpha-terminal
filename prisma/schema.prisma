generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Chain { SOLANA ETHEREUM BASE ARBITRUM BSC }
enum SignalSide { LONG SHORT WATCH }
enum WalletType { DEPLOYER SMART_MONEY WHALE CEX UNKNOWN }
model Asset { id String @id @default(cuid()) chain Chain address String symbol String? name String? decimals Int? verified Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt snapshots MarketSnapshot[] walletTxs WalletTransaction[] signals Signal[] @@unique([chain,address]) @@index([symbol]) }
model Narrative { id String @id @default(cuid()) name String description String? score Float @default(0) status String @default("WATCH") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt catalysts Catalyst[] }
model Catalyst { id String @id @default(cuid()) narrativeId String title String sourceUrl String? eventAt DateTime? impact Float @default(0) narrative Narrative @relation(fields:[narrativeId],references:[id],onDelete:Cascade) @@index([narrativeId,eventAt]) }
model Wallet { id String @id @default(cuid()) chain Chain address String label String? type WalletType @default(UNKNOWN) score Float @default(0) firstSeenAt DateTime? lastSeenAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt transactions WalletTransaction[] @@unique([chain,address]) @@index([type,score]) }
model WalletTransaction { id String @id @default(cuid()) walletId String assetId String? signature String side String? amount Decimal? @db.Decimal(38,18) usdValue Decimal? @db.Decimal(38,18) blockTime DateTime? metadata Json? wallet Wallet @relation(fields:[walletId],references:[id],onDelete:Cascade) asset Asset? @relation(fields:[assetId],references:[id]) @@unique([walletId,signature]) @@index([signature]) @@index([blockTime]) }
model Launch { id String @id @default(cuid()) chain Chain tokenAddress String deployerAddress String liquidityUsd Decimal? @db.Decimal(38,18) initialMarketCap Decimal? @db.Decimal(38,18) launchAt DateTime @default(now()) riskScore Float @default(0) metadata Json? @@index([chain,launchAt]) }
model DeFiPool { id String @id @default(cuid()) chain Chain protocol String poolAddress String token0 String token1 String tvlUsd Decimal? @db.Decimal(38,18) apr Float? volume24hUsd Decimal? @db.Decimal(38,18) riskScore Float @default(0) updatedAt DateTime @updatedAt @@unique([chain,protocol,poolAddress]) }
model MarketSnapshot { id String @id @default(cuid()) assetId String price Decimal @db.Decimal(38,18) change24h Float? volume24h Decimal? @db.Decimal(38,18) capturedAt DateTime @default(now()) asset Asset @relation(fields:[assetId],references:[id],onDelete:Cascade) @@index([assetId,capturedAt]) }
model Signal { id String @id @default(cuid()) assetId String? side SignalSide score Float confidence Float thesis String? entry Decimal? @db.Decimal(38,18) stopLoss Decimal? @db.Decimal(38,18) takeProfit Decimal? @db.Decimal(38,18) createdAt DateTime @default(now()) asset Asset? @relation(fields:[assetId],references:[id]) @@index([createdAt,score]) }
model TradeThesis { id String @id @default(cuid()) title String summary String status String @default("DRAFT") confidence Float @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }

model UserAlertSettings {
  id String @id @default(cuid())
  userEmail String @unique
  telegramEnabled Boolean @default(false)
  telegramBotTokenEncrypted String?
  telegramChatId String?
  priceAlerts Boolean @default(true)
  newsAlerts Boolean @default(true)
  walletAlerts Boolean @default(true)
  launchAlerts Boolean @default(true)
  riskAlerts Boolean @default(true)
  macroAlerts Boolean @default(true)
  realtime Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events AlertEvent[]
  @@index([userEmail])
}

model AlertEvent {
  id String @id @default(cuid())
  userEmail String
  settingsId String
  type String
  title String
  message String
  severity String @default("INFO")
  source String?
  metadata Json?
  sentTelegram Boolean @default(false)
  sentAt DateTime?
  createdAt DateTime @default(now())
  settings UserAlertSettings @relation(fields:[settingsId],references:[id],onDelete:Cascade)
  @@index([userEmail,createdAt])
  @@index([settingsId,createdAt])
}


model UserAISettings {
  id String @id @default(cuid())
  userEmail String @unique
  provider String @default("nvidia")
  baseUrl String @default("https://integrate.api.nvidia.com/v1")
  model String @default("nvidia/nemotron-3-ultra-550b-a55b")
  apiKeyEncrypted String?
  enableThinking Boolean @default(true)
  reasoningEffort String @default("medium")
  temperature Float @default(0.15)
  maxTokens Int @default(4096)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userEmail])
}
